# Gemini API — https://aistudio.google.com/apikey (free tier, no card
# required). Used both to generate the daily topic and to embed it for
# duplicate detection.
GEMINI_API_KEY=

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# OPTIONAL. Pollinations.ai image generation (the daily topic
# illustration) works with no key at all — anonymous use is rate-limited
# to 1 request/15s, far more than this site needs. Setting a key from
# https://auth.pollinations.ai only unlocks watermark removal.
POLLINATIONS_API_KEY=

# Injected automatically once you add the Upstash Redis integration from
# the Vercel Marketplace to this project — you shouldn't need to set these
# by hand, but they're listed here for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string — protects the /api/cron/generate route so only
# Vercel's own cron scheduler can trigger it. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=
